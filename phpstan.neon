includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:

    paths:
        - app/
        - modules/

    # Level 10 is the highest level
    level: 8

    configDirectories:
        - config
        - modules/*/Config

#    ignoreErrors:
#        - '#PHPDoc tag @var#'
#
    excludePaths:
        - modules/*/Tests/*
